<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_SuaThongTin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             mc:Ignorable="d" d:DesignWidth="800" Height="495">
    <UserControl.Resources>
        <SolidColorBrush x:Key="EditColor" Color="#059669"/>
    </UserControl.Resources>

    <Grid Margin="20,20,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Width="40" Height="40" Background="#FFE9E8E8" BorderThickness="0" Foreground="#1E6FB5"
                    Command="{Binding DataContext.NavHocVien, RelativeSource={RelativeSource AncestorType=Window}}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Button.Resources>
                <TextBlock Text="⬅" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
            <StackPanel Margin="15,0" VerticalAlignment="Center">
                <TextBlock Text="Chỉnh Sửa Thông Tin" FontSize="18" FontWeight="Bold" Foreground="#374151"/>
                <TextBlock Text="Cập nhật lại thông tin hồ sơ học viên hiện có" Foreground="#8AAAC8" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="40,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Chi tiết hồ sơ học viên" FontSize="16" FontWeight="Bold" Foreground="{StaticResource EditColor}" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã học viên (Cố định)" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#9CA3AF"/>
                        <Border Background="#F3F4F6" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox x:Name="txtMaHV"  IsReadOnly="True" Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" Foreground="#6B7280"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Họ và tên học viên" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox x:Name="txtHoTen" Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox x:Name="txtSDT" Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email liên hệ" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox x:Name="txtEmail" Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,0,0,18">
                    <TextBlock Text="Khóa học đăng ký" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                    <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                        <TextBox x:Name="txtKhoaHoc" Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy bỏ" Width="100" Height="40" Background="Transparent" Foreground="#6B7280" Margin="0,0,15,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Lưu các thay đổi" Width="180" Height="40" Background="{StaticResource EditColor}" Foreground="White" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
