<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_DangKyMoi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             xmlns:vm="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Direction="270" Color="#1E293B" Opacity="0.06"/>
        <SolidColorBrush x:Key="PrimaryBrush"      Color="#4F46E5"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>

        <!-- ===== COMBOBOX STYLE ===== -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0" Opacity="0"/>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200"
                                        Effect="{StaticResource CardShadow}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ĐĂNG KÝ KHÓA HỌC MỚI" FontSize="22" FontWeight="Bold" Foreground="#2D3748"/>
            <TextBlock Text="Vui lòng nhập đầy đủ thông tin để ghi danh vào lớp học" Foreground="#718096"/>
        </StackPanel>

        <!-- Grid chứa Form bên trái và DataGrid bên phải -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="Auto"/> <!-- Vách ngăn dọc -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form nhập liệu bên trái -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- Chọn Học Viên -->
                    <TextBlock Text="Chọn Học Viên *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,0,0,15"
                              ItemsSource="{Binding ListHocVien}"
                              SelectedItem="{Binding SelectedHocVien}"
                              DisplayMemberPath="HoTen"/>

                    <!-- Chọn Lớp Học -->
                    <TextBlock Text="Chọn Lớp Học *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,0,0,15"
                              ItemsSource="{Binding ListLopHoc}"
                              SelectedItem="{Binding SelectedLopHoc}"
                              DisplayMemberPath="TENLOP"/>

                    <!-- Ngày Đăng Ký -->
                    <TextBlock Text="Ngày Đăng Ký" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker Height="40" VerticalContentAlignment="Center" IsEnabled="True" 
                                SelectedDate="{Binding NgayDK, UpdateSourceTrigger=PropertyChanged}"
                                DisplayDateEnd="{x:Static System:DateTime.Today}" Margin="0,0,0,15"
                                xmlns:System="clr-namespace:System;assembly=mscorlib"/>

                    <!-- Học Phí -->
                    <TextBlock Text="Học Phí (VNĐ)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15" 
                             Text="{Binding HocPhi, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"/>

                    <!-- Trạng Thái Ban Đầu -->
                    <TextBlock Text="Trạng Thái Ban Đầu" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,0,0,15"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding TrangThai, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Cho dong tien"/>
                        <ComboBoxItem Content="Dang hoc"/>
                        <ComboBoxItem Content="Bao luu"/>
                        <ComboBoxItem Content="Hoan thanh"/>
                        <ComboBoxItem Content="Huy"/>
                    </ComboBox>


                    <Border Background="#EBF8FF" Margin="0,20,0,0" Padding="15" CornerRadius="8">
                        <TextBlock Text="Lưu ý: Học viên sẽ được tự động thêm vào danh sách điểm danh sau khi hoàn tất đóng học phí." 
                                   Foreground="#3182CE" TextWrapping="Wrap" FontSize="11" FontStyle="Italic"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Vách ngăn dọc -->
            <Grid Grid.Column="1" Width="1" Background="#E2E8F0" Margin="5,0,15,0"/>

            <!-- DataGrid bên phải hiển thị danh sách đăng ký hiện có -->
            <Grid Grid.Column="2">
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="Auto"/>
                 </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="DANH SÁCH ĐĂNG KÝ HIỆN TẠI" FontSize="16" FontWeight="Bold" Foreground="#2D3748"/>
                    <TextBlock Text="Nhấp đúp chuột để chỉnh sửa và nhấn Xác nhận sửa" FontSize="12" Foreground="#718096"/>
                </StackPanel>

                <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                    <DataGrid AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True"
                              ItemsSource="{Binding ListDangKy}"
                              SelectedItem="{Binding SelectedItem}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF2F7"
                              RowHeight="50"
                              BorderThickness="0"
                              SelectionMode="Single"
                              x:Name="dgDangKyMoiPhai">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,10"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã HV" Binding="{Binding MaHV}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Tên học viên" Binding="{Binding HOCVIEN.HoTen}" IsReadOnly="True" Width="1.2*"/>
                            <DataGridTextColumn Header="Lớp Học" Binding="{Binding LOPHOC.TENLOP}" IsReadOnly="True" Width="1.2*"/>
                            
                            <DataGridTemplateColumn Header="Ngày Đăng Ký" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NGAYDK, StringFormat=dd/MM/yyyy}" VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Học Phí" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HOCPHI, StringFormat={}{0:N0} VNĐ}" VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="Trạng Thái" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="#EDF2F7">
                                            <TextBlock Text="{Binding TRANGTHAI}" FontSize="11" FontWeight="Bold" Foreground="#2D3748"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </Grid>
        </Grid>

        <!-- Nút lưu -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy bỏ" Command="{Binding CancelCommand}" Width="100" Height="40" Background="Transparent" BorderBrush="#CBD5E0" Margin="0,0,10,0"/>
            <Button Content="Xác nhận Đăng ký" Command="{Binding SaveCommand}" Width="160" Height="40" Background="#3182CE" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>