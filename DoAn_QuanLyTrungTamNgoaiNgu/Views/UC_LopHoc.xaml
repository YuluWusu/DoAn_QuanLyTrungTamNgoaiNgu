<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_LopHoc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:custom="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.CustomControls"
             xmlns:vm="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1280">

    <UserControl.Resources>
        <Style TargetType="{x:Type Calendar}">
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="False"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        </Style>

        <DropShadowEffect x:Key="SoftShadow"  BlurRadius="18" ShadowDepth="3" Opacity="0.07" Color="#0F172A"/>
        <DropShadowEffect x:Key="HoverShadow" BlurRadius="30" ShadowDepth="6" Opacity="0.13" Color="#2563EB"/>
        <DropShadowEffect x:Key="SidebarShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.08" Color="#0F172A"/>
        <DropShadowEffect x:Key="BadgeShadow"  BlurRadius="8"  ShadowDepth="1" Opacity="0.12" Color="#16A34A"/>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1D4ED8" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F1F5F9" Offset="0"/>
            <GradientStop Color="#E2E8F0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8FAFC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#6366F1" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ClassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#EEF2FF"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                    <Setter Property="Effect" Value="{StaticResource HoverShadow}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.008" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.008" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btn" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btn" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btn" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btn" Background="{TemplateBinding Background}"
                                BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btn" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btn" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btn" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EventCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F0F4F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarGradient}"
                BorderBrush="#E8EEFB" BorderThickness="0,0,1.5,0"
                Effect="{StaticResource SidebarShadow}">
            <DockPanel>

                <Separator DockPanel.Dock="Top" Background="#EEF2FF" Margin="20,0"/>
                <Border DockPanel.Dock="Top" Padding="20,16,20,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Lịch trình" FontSize="16" FontWeight="Bold"
                                       Foreground="#1E293B" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="›" Style="{StaticResource IconButtonStyle}"
                                    HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Separator DockPanel.Dock="Top" Background="#EEF2FF" Margin="20,14"/>

                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Hidden" Padding="20,0,20,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="3" Height="14" Background="{StaticResource AccentGradient}" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="LỚP HỌC ĐANG MỞ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ListLopHocDangMo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource EventCardStyle}" Background="#EFF6FF">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="4" Height="36" CornerRadius="2"
                                    Background="{StaticResource PrimaryGradient}"
                                    VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TENLOP}" FontWeight="SemiBold"
                                           FontSize="13" Foreground="#1E293B"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#DBEAFE" CornerRadius="6"
                                    Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="GV" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border DockPanel.Dock="Bottom" Height="75" Margin="20,16" Padding="16,14"
                        Background="{StaticResource PrimaryGradient}" CornerRadius="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalClasses, FallbackValue='0'}" 
               FontSize="22" FontWeight="Bold"
               Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Lớp học" FontSize="11" Foreground="#BFDBFE"
               HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right"
           Fill="#FFFFFF" Opacity="0.2" Margin="0,4"/>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalStudents, FallbackValue='0'}" 
               FontSize="22" FontWeight="Bold"
               Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Học viên" FontSize="11" Foreground="#BFDBFE"
               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="36,28,36,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Danh Sách Lớp Học"
                               FontSize="30" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Quản lý và theo dõi tiến độ các lớp học đang hoạt động"
                               FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Button Height="42" Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,28,0"
                        Command="{Binding XoaTimKiem }">
                        <TextBlock Text="❌ Xóa tìm kiếm" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                    </Button>
                    <Button Height="42" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Tạo lớp mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Style="{StaticResource SearchBoxStyle}" Height="42"
                         MaxWidth="400" Width="340"
                         Padding="5"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource SearchBoxStyle}"/>
                    </TextBox.Resources>
                </TextBox>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Height="42" Style="{StaticResource OutlineButtonStyle}"
                            Margin="0,0,8,0"
                            Command="{Binding LocTheoTrangThai}"
                            CommandParameter="Dang mo">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Đang mở" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                        </StackPanel>
                    </Button>
                    <Button Height="42" Style="{StaticResource OutlineButtonStyle}"
                            Margin="0,0,8,0"
                            Command="{Binding LocTheoTrangThai}"
                            CommandParameter="Da ket thuc">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Đã kết thúc" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                        </StackPanel>
                    </Button>
                    <Button Height="42" Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding HienTatCa}">
                        <TextBlock Text="Tất cả" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                          Padding="0,0,4,20">
                <ItemsControl ItemsSource="{Binding FilteredList}" Width="938">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ClassCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="4" CornerRadius="2" Background="{StaticResource AccentGradient}"
                                                Margin="0,0,12,0">
                                                <Border.Height>
                                                    <Binding Source="48"/>
                                                </Border.Height>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <Border Background="#EEF2FF" CornerRadius="8" Padding="8,4">
                                                    <TextBlock Text="{Binding MALOP}" FontSize="13"
                                                           FontWeight="Bold" Foreground="#4338CA"/>
                                                </Border>
                                                <TextBlock Text="Mã lớp" FontSize="10" Foreground="#94A3B8" Margin="2,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding TENLOP}" FontSize="16"
                                                   FontWeight="Bold" Foreground="#0F172A"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Background="#F0FDF4" CornerRadius="8"
                                                    Padding="10,4" Margin="0,0,8,0"
                                                    Effect="{StaticResource BadgeShadow}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📍 " FontSize="10"/>
                                                        <TextBlock Text="PHÒNG ..." FontSize="10"
                                                               FontWeight="Bold" Foreground="#16A34A"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border CornerRadius="8" Padding="10,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="#EF4444"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding TRANGTHAI}" FontSize="10"
                                                               FontWeight="Bold" Foreground="#DC2626"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="14"
                                            Padding="14,10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="38" Height="38" CornerRadius="19"
                                                    Background="{StaticResource PrimaryGradient}">
                                                    <TextBlock Text="👤" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GIAOVIEN.TenGV}"
                                                           FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                                    <TextBlock Text="Giáo viên phụ trách" FontSize="10"
                                                           Foreground="#94A3B8" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DANGKYLOPs.Count, FallbackValue='0'}" 
                   FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text=" / " FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding SISO_TOIDA, FallbackValue='30'}" 
                   FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                            </StackPanel>

                                            <TextBlock Text="Học viên" FontSize="10" Foreground="#94A3B8"
               HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Chỉnh sửa" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                                <TextBlock Text="✏" FontSize="14"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Xóa lớp"
                                                Command="{Binding DataContext.CancelCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                                <TextBlock Text="🚫" FontSize="13"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Expander Header="Chi tiết học viên" Margin="0,15,0,0" Foreground="#3B82F6" FontSize="12" FontWeight="SemiBold">
                                        <DataGrid ItemsSource="{Binding DANGKYLOPs}" AutoGenerateColumns="False" 
                                              HeadersVisibility="None" Background="#F8FAFC" BorderThickness="0" Margin="0,10,0,0" IsReadOnly="True"
                                              RowBackground="Transparent" AlternatingRowBackground="#EEF2FF" GridLinesVisibility="None">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding HOCVIEN.HoTen}" Width="200" />
                                                <DataGridTextColumn Binding="{Binding HOCVIEN.SDT}" Width="150" />
                                                <DataGridTextColumn Binding="{Binding TRANGTHAI}" Width="150" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
