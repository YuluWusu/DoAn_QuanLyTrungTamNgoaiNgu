<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_SuaThongTinHV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             xmlns:vm="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" Height="506">
    <UserControl.DataContext>
        <vm:VM_HocVien/>
    </UserControl.DataContext>
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="EditColor" Color="#059669"/>
    </UserControl.Resources>

    <Grid Margin="20,20,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="⬅" Command="{Binding BackCommand}" FontSize="18" Width="40" Height="40" Background="White" BorderThickness="0" Cursor="Hand" Foreground="{StaticResource EditColor}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Button.Resources>
            </Button>
            <StackPanel Margin="15,0" VerticalAlignment="Center">
                <TextBlock Text="Chỉnh Sửa Thông Tin" FontSize="18" FontWeight="Bold" Foreground="#374151"/>
                <TextBlock Text="Cập nhật lại thông tin hồ sơ học viên hiện có" Foreground="#8AAAC8" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="40,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Thông tin định danh" FontSize="16" FontWeight="Bold" Foreground="{StaticResource EditColor}" Margin="0,0,0,20"/>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Mã học viên (Cố định)" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                        <Border Background="#F3F4F6" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox x:Name="txtMaHV" Text="{Binding NewHV.MaHV}"  IsReadOnly="True" Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" Foreground="#6B7280"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Họ Tên" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#374151"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox x:Name="txtHoTen" Text="{Binding NewHV.HoTen}" Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Ngày Sinh" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#374151"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <DatePicker SelectedDate="{Binding NewHV.NgaySinh, UpdateSourceTrigger=PropertyChanged}"
                             Height="42"
                             BorderThickness="0"
                             Background="{x:Null}"
                             Padding="8,0" VerticalAlignment="Center" 
                             VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Giới Tính" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#374151"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <ComboBox x:Name="cboGioiTinh" Height="42" Background="Transparent" BorderThickness="0"
                                      VerticalContentAlignment="Center" Padding="12,0" ItemsSource="{Binding dsGioiTinh}"
                                      SelectedItem="{Binding NewHV.GioiTinh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Địa Chỉ" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox x:Name="txtDiaChi" Text="{Binding NewHV.DiaChi}" Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Số Điện Thoại" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox x:Name="txtSDT" Text="{Binding NewHV.SDT}" Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Email" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#374151"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox x:Name="txtEmail" Text="{Binding NewHV.Email}" Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,0,0">
                        <TextBlock Text="Khóa học đăng ký"  FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <ComboBox x:Name="cboKhoaHoc" Height="42" Background="Transparent" 
                           BorderThickness="0" VerticalContentAlignment="Center" 
                           Padding="12,0" ItemsSource="{Binding dsLop}"
                                      SelectedItem="{Binding SelectedLop, Mode=TwoWay}"
                                      DisplayMemberPath="TENLOP"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy bỏ"  Command="{Binding CancelCommand}" Width="100" Height="40" Background="Transparent" Foreground="#6B7280" Margin="0,0,15,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Lưu các thay đổi" Command="{Binding UpdateCommand}" Width="180" Height="40" Background="{StaticResource EditColor}" Foreground="White" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
