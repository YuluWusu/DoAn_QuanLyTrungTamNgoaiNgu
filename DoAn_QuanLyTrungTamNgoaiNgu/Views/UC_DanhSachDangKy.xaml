<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_DanhSachDangKy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             xmlns:vm="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="AccentColor" Color="#1E6FB5"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Direction="270" Color="#1E293B" Opacity="0.06"/>
        <SolidColorBrush x:Key="PrimaryBrush"      Color="#4F46E5"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>

        <!-- ===== COMBOBOX STYLE ===== -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0" Opacity="0"/>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200"
                                        Effect="{StaticResource CardShadow}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Tìm kiếm & Bộ lọc -->
            <RowDefinition Height="*"/>
            <!-- Bảng dữ liệu -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="DANH SÁCH ĐĂNG KÝ KHÓA HỌC" FontSize="26" FontWeight="ExtraBold" Foreground="#1A365D"/>
            <TextBlock Text="Quản lý thông tin đăng ký lớp và học phí của học viên" FontSize="14" Foreground="#718096" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20,15" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="350">
                    <TextBlock Text="Tìm kiếm học viên/Lớp" FontSize="12" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,8"/>
                    <TextBox Height="40" VerticalContentAlignment="Center" Padding="12,0" FontSize="14" BorderBrush="#CBD5E0" Text="{Binding FilterSearchQuery, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Margin="20,0,0,0" Width="200">
                    <TextBlock Text="Trạng thái đăng ký" FontSize="12" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,8"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" SelectedValue="{Binding FilterTrangThai, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
                        <ComboBoxItem Content="-- Tất cả --"/>
                        <ComboBoxItem Content="Cho dong tien"/>
                        <ComboBoxItem Content="Dang hoc"/>
                        <ComboBoxItem Content="Bao luu"/>
                        <ComboBoxItem Content="Hoan thanh"/>
                        <ComboBoxItem Content="Huy"/>
                    </ComboBox>
                </StackPanel>

                <Button Content="Lọc dữ liệu" Command="{Binding FilterCommand}" IsEnabled="{Binding IsOtherButtonsEnabled}" Width="120" Height="40" Margin="20,20,0,0" 
                    Background="#2D3748" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button Content="Làm mới" Command="{Binding RefreshCommand}" Width="120" Height="40" Margin="10,20,0,0" 
                    Background="#3182CE" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
 
         <!-- 3. Bảng dữ liệu (DataGrid) -->
         <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
             <DataGrid AutoGenerateColumns="False" 
                   CanUserAddRows="False" 
                   IsReadOnly="{Binding IsReadOnly}"
                   ItemsSource="{Binding ListDangKy}"
                   SelectedItem="{Binding SelectedItem}"
                   HeadersVisibility="Column"
                   GridLinesVisibility="Horizontal"
                   HorizontalGridLinesBrush="#EDF2F7"
                   RowHeight="55"
                   BorderThickness="0"
                   SelectionMode="Single"
                   x:Name="dgDangKy">
 
                 <DataGrid.ColumnHeaderStyle>
                     <Style TargetType="DataGridColumnHeader">
                         <Setter Property="Background" Value="#F8FAFC"/>
                         <Setter Property="Foreground" Value="#475569"/>
                         <Setter Property="FontWeight" Value="Bold"/>
                         <Setter Property="Padding" Value="15,15"/>
                         <Setter Property="BorderBrush" Value="#E2E8F0"/>
                         <Setter Property="BorderThickness" Value="0,0,0,2"/>
                     </Style>
                 </DataGrid.ColumnHeaderStyle>
 
                 <DataGrid.Columns>
                     <DataGridTextColumn Header="Mã HV" Binding="{Binding MaHV}" IsReadOnly="True" Width="100"/>
                     <DataGridTextColumn Header="Tên học viên" Binding="{Binding HOCVIEN.HoTen}" IsReadOnly="True" Width="1.8*"/>
                     <DataGridTextColumn Header="Lớp Học" Binding="{Binding LOPHOC.TENLOP}" IsReadOnly="True" Width="1.8*"/>
 
                     <DataGridTemplateColumn Header="Ngày Đăng Ký" Width="150">
                         <DataGridTemplateColumn.CellTemplate>
                             <DataTemplate>
                                 <TextBlock Text="{Binding NGAYDK, StringFormat=dd/MM/yyyy}" VerticalAlignment="Center" Margin="15,0"/>
                             </DataTemplate>
                         </DataGridTemplateColumn.CellTemplate>
                         <DataGridTemplateColumn.CellEditingTemplate>
                             <DataTemplate>
                                 <DatePicker SelectedDate="{Binding NGAYDK, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                             </DataTemplate>
                         </DataGridTemplateColumn.CellEditingTemplate>
                     </DataGridTemplateColumn>

                     <DataGridTemplateColumn Header="Học Phí" Width="150">
                         <DataGridTemplateColumn.CellTemplate>
                             <DataTemplate>
                                 <TextBlock Text="{Binding HOCPHI, StringFormat={}{0:N0} VNĐ}" VerticalAlignment="Center" Margin="15,0"/>
                             </DataTemplate>
                         </DataGridTemplateColumn.CellTemplate>
                         <DataGridTemplateColumn.CellEditingTemplate>
                             <DataTemplate>
                                 <TextBox Text="{Binding HOCPHI, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5,2"/>
                             </DataTemplate>
                         </DataGridTemplateColumn.CellEditingTemplate>
                     </DataGridTemplateColumn>

                     <DataGridTemplateColumn Header="Trạng Thái" Width="150">
                         <DataGridTemplateColumn.CellTemplate>
                             <DataTemplate>
                                 <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" Background="#EDF2F7">
                                     <TextBlock Text="{Binding TRANGTHAI}" FontSize="12" FontWeight="Bold" Foreground="#2D3748"/>
                                 </Border>
                             </DataTemplate>
                         </DataGridTemplateColumn.CellTemplate>
                         <DataGridTemplateColumn.CellEditingTemplate>
                             <DataTemplate>
                                 <ComboBox Style="{StaticResource ModernComboBox}" SelectedValue="{Binding TRANGTHAI, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Height="30" VerticalContentAlignment="Center">
                                     <ComboBoxItem Content="Cho dong tien"/>
                                     <ComboBoxItem Content="Dang hoc"/>
                                     <ComboBoxItem Content="Bao luu"/>
                                     <ComboBoxItem Content="Hoan thanh"/>
                                     <ComboBoxItem Content="Huy"/>
                                 </ComboBox>
                             </DataTemplate>
                         </DataGridTemplateColumn.CellEditingTemplate>
                     </DataGridTemplateColumn>
                 </DataGrid.Columns>
             </DataGrid>
         </Border>
 
         <Border Grid.Row="3" Margin="0,20,0,0" Padding="20" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
             <Grid>
                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                     <TextBlock Text="Đang chọn:" Foreground="#718096" FontSize="13"/>
                     <TextBlock Text="{Binding SelectedItem.HOCVIEN.HoTen}" FontWeight="Bold" Foreground="#1A365D" Margin="8,0,0,0" FontSize="14"/>
                     <TextBlock Text="-" Foreground="#718096" Margin="8,0"/>
                     <TextBlock Text="{Binding SelectedItem.LOPHOC.TENLOP}" FontWeight="Bold" Foreground="#1A365D" FontSize="14"/>
                 </StackPanel>
 
                 <!-- Các nút hành động -->
                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                     <Button Content="Hủy/Xóa đăng ký" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsOtherButtonsEnabled}" Width="130" Height="45" Background="Transparent" Foreground="#E53E3E" 
                         BorderBrush="#FED7D7" BorderThickness="1" Margin="0,0,10,0" FontWeight="SemiBold">
                         <Button.Resources>
                             <Style TargetType="Border">
                                 <Setter Property="CornerRadius" Value="8"/>
                             </Style>
                         </Button.Resources>
                     </Button>
 
                     <Button Content="{Binding EditButtonText}" Command="{Binding EditCommand}" Width="130" Height="45" Background="White" Foreground="#D69E2E" 
                         BorderBrush="#FEFCBF" BorderThickness="1" Margin="0,0,20,0" FontWeight="SemiBold">
                         <Button.Resources>
                             <Style TargetType="Border">
                                 <Setter Property="CornerRadius" Value="8"/>
                             </Style>
                         </Button.Resources>
                     </Button>
 
                     <!-- Nút thêm mới -->
                     <Button Command="{Binding AddCommand}" IsEnabled="{Binding IsOtherButtonsEnabled}" Content="+ THÊM ĐĂNG KÝ" Width="180" Height="45" Background="#3182CE" Foreground="White" 
                         FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>