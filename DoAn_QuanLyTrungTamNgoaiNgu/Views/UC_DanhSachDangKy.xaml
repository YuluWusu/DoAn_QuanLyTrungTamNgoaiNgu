<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_DanhSachDangKy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             xmlns:vm="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="AccentColor" Color="#1E6FB5"/>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Tìm kiếm & Bộ lọc -->
            <RowDefinition Height="*"/>
            <!-- Bảng dữ liệu -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="DANH SÁCH ĐĂNG KÝ KHÓA HỌC" FontSize="26" FontWeight="ExtraBold" Foreground="#1A365D"/>
            <TextBlock Text="Quản lý thông tin đăng ký lớp và học phí của học viên" FontSize="14" Foreground="#718096" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20,15" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="350">
                    <TextBlock Text="Tìm kiếm học viên/Lớp" FontSize="12" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,8"/>
                    <TextBox Height="40" VerticalContentAlignment="Center" Padding="12,0" FontSize="14" BorderBrush="#CBD5E0">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Margin="20,0,0,0" Width="200">
                    <TextBlock Text="Trạng thái đăng ký" FontSize="12" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,8"/>
                    <ComboBox Height="40" VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="-- Tất cả --"/>
                        <ComboBoxItem Content="Chờ đóng tiền"/>
                        <ComboBoxItem Content="Đang học"/>
                        <ComboBoxItem Content="Bảo lưu"/>
                        <ComboBoxItem Content="Hoàn thành"/>
                        <ComboBoxItem Content="Hủy"/>
                    </ComboBox>
                </StackPanel>

                <Button Content="Lọc dữ liệu" Width="120" Height="40" Margin="20,20,0,0" 
                    Background="#2D3748" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- 3. Bảng dữ liệu (DataGrid) -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EDF2F7"
                  RowHeight="55"
                  BorderThickness="0"
                  SelectionMode="Single"
                  x:Name="dgDangKy">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="15,15"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã HV" Binding="{Binding MaHV}" Width="100"/>
                    <DataGridTextColumn Header="Tên học viên" Binding="{Binding HoTenHV}" Width="1.8*"/>
                    <DataGridTextColumn Header="Lớp Học" Binding="{Binding TenLop}" Width="1.8*"/>
                    <DataGridTextColumn Header="Ngày Đăng Ký" Binding="{Binding NgayDK, StringFormat=dd/MM/yyyy}" Width="150"/>
                    <DataGridTextColumn Header="Học Phí" Binding="{Binding HocPhi, StringFormat={}{0:N0} VNĐ}" Width="150"/>
                    <DataGridTemplateColumn Header="Trạng Thái" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" Background="#EDF2F7">
                                    <TextBlock Text="{Binding TrangThai}" FontSize="12" FontWeight="Bold" Foreground="#2D3748"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Margin="0,20,0,0" Padding="20" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Đang chọn:" Foreground="#718096" FontSize="13"/>
                    <TextBlock Text="{Binding SelectedItem.HoTenHV}" FontWeight="Bold" Foreground="#1A365D" Margin="8,0,0,0" FontSize="14"/>
                    <TextBlock Text="-" Foreground="#718096" Margin="8,0"/>
                    <TextBlock Text="{Binding SelectedItem.MaLop}" FontWeight="Bold" Foreground="#1A365D" FontSize="14"/>
                </StackPanel>

                <!-- Các nút hành động -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy đăng ký" Width="130" Height="45" Background="Transparent" Foreground="#E53E3E" 
                        BorderBrush="#FED7D7" BorderThickness="1" Margin="0,0,10,0" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="Sửa thông tin" Width="130" Height="45" Background="White" Foreground="#D69E2E" 
                        BorderBrush="#FEFCBF" BorderThickness="1" Margin="0,0,20,0" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Nút thêm mới được đặt ở đây theo yêu cầu -->
                    <Button Command="{Binding AddCommand}" Content="+ THÊM ĐĂNG KÝ" Width="180" Height="45" Background="#3182CE" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
