<Window x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.EditLopHoc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="EditLopHoc" Height="650" Width="800">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.07" Color="#0F172A"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2563EB" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="White" CornerRadius="10"
                                BorderBrush="#E2E8F0" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24" Background="White" CornerRadius="20"
            Effect="{StaticResource CardShadow}">
        <StackPanel Margin="28,24">

            <TextBlock x:Name="txbHeader" Text="Tạo lớp mới" FontSize="18" FontWeight="Bold"
               Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock x:Name="txbMaLop" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,20"/>

            <StackPanel x:Name="pnlTaoMoi" Visibility="Collapsed">

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã lớp" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtMaLop" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tên lớp" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtTenLopMoi" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Khóa học" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cboKhoaHoc" Style="{StaticResource ComboStyle}"
                          DisplayMemberPath="TENKH" SelectedValuePath="MAKH"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sĩ số tối đa" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtSiSo" Style="{StaticResource InputStyle}" Text="20"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Giáo viên phụ trách" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cboGiaoVienMoi" Style="{StaticResource ComboStyle}"
                          DisplayMemberPath="TenGV" SelectedValuePath="MaGV"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ngày bắt đầu" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="dpNgayBatDau" Height="40" FontSize="13"
                            BorderBrush="#E2E8F0" BorderThickness="1.5"
                            SelectedDate="{x:Static sys:DateTime.Today}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phòng học" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cboPhong" Style="{StaticResource ComboStyle}"
                          DisplayMemberPath="TENPHONG" SelectedValuePath="MAPHONG"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ca học" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cboCa" Style="{StaticResource ComboStyle}"
                          DisplayMemberPath="TENCA" SelectedValuePath="MACA"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Ngày học trong tuần" Style="{StaticResource LabelStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <CheckBox x:Name="chkT2" Content="T2" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkT3" Content="T3" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkT4" Content="T4" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkT5" Content="T5" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkT6" Content="T6" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkT7" Content="T7" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkCN" Content="CN" VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>

            <StackPanel x:Name="pnlChinhSua" Visibility="Collapsed">
                <TextBlock Text="Tên lớp" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtTenLop" Style="{StaticResource InputStyle}" Margin="0,0,0,16"/>
                <TextBlock Text="Giáo viên phụ trách" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="cboGiaoVien" Style="{StaticResource ComboStyle}"
                  DisplayMemberPath="TenGV" SelectedValuePath="MaGV"
                  Margin="0,0,0,24"/>
            </StackPanel>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCancel" Content="Hủy" Style="{StaticResource SecondaryBtn}"
                Padding="0" Click="btnCancel_Click"/>
                <Button x:Name="btnSave" Grid.Column="2" Content="Lưu"
                Style="{StaticResource PrimaryBtn}" Padding="0" Click="btnSave_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
