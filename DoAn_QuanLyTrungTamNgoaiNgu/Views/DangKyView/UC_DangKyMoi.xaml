<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_DangKyMoi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             xmlns:vm="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ĐĂNG KÝ HỌC VIÊN MỚI" FontSize="22" FontWeight="Bold" Foreground="#2D3748"/>
            <TextBlock Text="Vui lòng nhập đầy đủ thông tin để ghi danh vào lớp học" Foreground="#718096"/>
        </StackPanel>

        <!-- Form nhập liệu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Chọn Học Viên *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Height="40" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding ListHocVien}"
                                  SelectedItem="{Binding SelectedHocVien}"
                                  DisplayMemberPath="HoTen"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Chọn Lớp Học *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Height="40" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding ListLopHoc}"
                                  SelectedItem="{Binding SelectedLopHoc}"
                                  DisplayMemberPath="TENLOP"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Ngày Đăng Ký (Tự động cập nhật)" FontWeight="SemiBold" Margin="0,15,0,5"/>
                <DatePicker Height="40" VerticalContentAlignment="Center" IsEnabled="False" SelectedDate="{x:Static System:DateTime.Now}"
                            xmlns:System="clr-namespace:System;assembly=mscorlib"/>

                <TextBlock Text="Học Phí (VNĐ)" FontWeight="SemiBold" Margin="0,15,0,5"/>
                <TextBox Height="40" VerticalContentAlignment="Center" Padding="10,0" 
                    Text="{Binding HocPhi, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"/>

                <TextBlock Text="Trạng Thái Ban Đầu" FontWeight="SemiBold" Margin="0,15,0,5"/>
                <ComboBox Height="40" VerticalContentAlignment="Center" 
                          SelectedValuePath="Content"
                          SelectedValue="{Binding TrangThai, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Cho dong tien"/>
                    <ComboBoxItem Content="Dang hoc"/>
                </ComboBox>

                <Border Background="#EBF8FF" Margin="0,25,0,0" Padding="15" CornerRadius="8">
                    <TextBlock Text="Lưu ý: Học viên sẽ được tự động thêm vào danh sách điểm danh sau khi hoàn tất đóng học phí." 
                               Foreground="#3182CE" TextWrapping="Wrap" FontSize="12" FontStyle="Italic"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Nút lưu -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy bỏ" Command="{Binding CancelCommand}" Width="100" Height="40" Background="Transparent" BorderBrush="#CBD5E0" Margin="0,0,10,0"/>
            <Button Content="Xác nhận Đăng ký" Command="{Binding SaveCommand}" Width="160" Height="40" Background="#3182CE" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>