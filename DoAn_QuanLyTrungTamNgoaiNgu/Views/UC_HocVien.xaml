<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_HocVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             xmlns:vm="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:VM_HocVien/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="AccentColor" Color="#1E6FB5"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="45" Height="45" Background="#EEF2FF" CornerRadius="10">
                        <TextBlock Text="👨‍🎓" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="15,0">
                        <TextBlock Text="Quản lý Học viên" FontSize="18" FontWeight="Bold" Foreground="#374151"/>
                        <TextBlock Text="Danh sách học viên toàn trung tâm" Foreground="#8AAAC8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F9FAFB" CornerRadius="8" Width="250" Height="38" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Text="🔍" Margin="10,0" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                            <TextBox x:Name="txtSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="32,0,10,0" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Tìm kiếm..." Margin="35,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" IsHitTestVisible="False"
                                 Visibility="{Binding ElementName=txtSearch, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                    <Button Content="+ Thêm mới" Width="110" Height="38" Background="{StaticResource AccentColor}" 
                          Foreground="White" FontWeight="SemiBold"
                          Command="{Binding DataContext.NavThemHocVien, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="10">
            <DataGrid x:Name="dgHocVien" 
              ItemsSource="{Binding dsHV}" 
              SelectedItem="{Binding SelectedDK, Mode=TwoWay}"
              AutoGenerateColumns="False" 
              CanUserAddRows="False" 
              Background="Transparent" 
              BorderThickness="0" 
              GridLinesVisibility="None" 
              RowHeight="55"
              IsReadOnly="True">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9FAFB"/>
                        <Setter Property="Foreground" Value="#6B7280"/>
                        <Setter Property="Padding" Value="15,12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F3F4F6"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="MÃ HV" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HOCVIEN.MaHV}" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center" 
                                   Foreground="#6B7280"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="HỌ TÊN" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HOCVIEN.HoTen}" 
                                   VerticalAlignment="Center" 
                                   FontWeight="Medium" 
                                   Foreground="#374151" 
                                   Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Ngày Sinh" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HOCVIEN.NgaySinh, StringFormat=\{0:dd/MM/yyyy\}}" 
                       VerticalAlignment="Center" 
                       FontWeight="Medium" 
                       Foreground="#374151" 
                       Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Giới tính" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HOCVIEN.GioiTinh}"  VerticalAlignment="Center" 
                                           FontWeight="Medium" Foreground="#374151"  Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Địa chỉ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HOCVIEN.DiaChi}" VerticalAlignment="Center" 
                                           FontWeight="Medium" Foreground="#374151" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SỐ ĐIỆN THOẠI" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HOCVIEN.SDT}" 
                                   VerticalAlignment="Center" 
                                   Foreground="#374151" 
                                   Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Email" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HOCVIEN.Email}" VerticalAlignment="Center" 
                                           FontWeight="Medium" Foreground="#374151" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Trạng thái" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HOCVIEN.TrangThai}" VerticalAlignment="Center" 
                                           FontWeight="Medium" Foreground="#374151" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️" ToolTip="Sửa" 
                                    Background="Transparent" BorderThickness="0" Margin="0,0,15,0" 
                                    FontSize="16" Cursor="Hand"
                                    Command="{Binding DataContext.NavSuaHocVien, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

                                    <Button Content="🗑️" ToolTip="Xóa" 
                                    Background="Transparent" BorderThickness="0" 
                                    FontSize="16" Cursor="Hand"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
