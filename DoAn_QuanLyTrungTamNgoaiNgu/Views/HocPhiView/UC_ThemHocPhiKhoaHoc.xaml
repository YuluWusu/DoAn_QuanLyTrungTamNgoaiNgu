<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_ThemHocPhiKhoaHoc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             mc:Ignorable="d" 
            d:DesignHeight="650" d:DesignWidth="1100"
             Background="#F4F6FA">

    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <!-- Phần Form nhập liệu (Trái) -->
            <ColumnDefinition Width="400"/>
            <!-- Phần DataGrid danh sách (Phải) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: FORM NHẬP LIỆU -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,20,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#000000" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="THÊM KHÓA HỌC MỚI" FontSize="20" FontWeight="Bold" Foreground="#1E6FB5" Margin="0,0,0,20"/>

                <TextBlock Text="Mã khóa học (Tự động tạo) *" Style="{StaticResource FormLabel}"/>
                <Border Background="#E2E8F0" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                    <TextBox Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" Text="{Binding MaKH, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" MaxLength="5"/>
                </Border>

                <TextBlock Text="Tên khóa học *" Style="{StaticResource FormLabel}"/>
                <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                    <TextBox Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" Text="{Binding TenKH, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <TextBlock Text="Loại khóa học *" Style="{StaticResource FormLabel}"/>
                <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                    <ComboBox Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0"
                              ItemsSource="{Binding ListLoaiKhoaHoc}" SelectedItem="{Binding SelectedLoaiKH}" DisplayMemberPath="TENLOAI"/>
                </Border>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Số buổi *" Style="{StaticResource FormLabel}"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" Text="{Binding SoBuoi}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Học phí gốc (VNĐ) *" Style="{StaticResource FormLabel}"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox Height="42" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" Text="{Binding HocPhi, StringFormat={}{0:N0}}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Background="#EBF8FF" Margin="0,20,0,0" Padding="15" CornerRadius="8">
                    <TextBlock Text="Lưu ý: Học phí và số buổi phải lớn hơn 0. Kiểm tra danh sách bên cạnh để tránh trùng Mã." 
                               Foreground="#3182CE" TextWrapping="Wrap" FontSize="12" FontStyle="Italic"/>
                </Border>

                <!-- Các nút hành động -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                    <Button Content="⬅ Quay lại" Width="100" Height="42" Background="Transparent" Foreground="#6B7280" 
                            BorderThickness="0" Margin="0,0,10,0" Command="{Binding CancelCommand}" Cursor="Hand"/>

                    <Button Content="Làm mới" Width="90" Height="42" Background="#F3F4F6" Foreground="#4B5563" 
                            BorderThickness="0" Margin="0,0,10,0" Command="{Binding RefreshCommand}" FontWeight="Medium">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="Lưu Khóa Học" Width="140" Height="42" Background="#059669" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Command="{Binding SaveCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#059669"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CỘT PHẢI: DANH SÁCH THAM KHẢO -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#000000" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DANH SÁCH KHÓA HỌC HIỆN TẠI" FontSize="16" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,15"/>

                <!-- Đã loại bỏ GridLines, cập nhật Header giống UC_HocVien -->
                <Border Grid.Row="1" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="55"
                              BorderThickness="0" Background="Transparent" ItemsSource="{Binding ListKhoaHoc}">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="15,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ" Binding="{Binding MAKH}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="15,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="TÊN KHÓA HỌC" Binding="{Binding TENKH}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="15,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="#374151"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="SỐ BUỔI" Binding="{Binding SOBUOI}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="15,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#4B5563"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="HỌC PHÍ (VNĐ)" Binding="{Binding HOCPHI_GD, StringFormat={}{0:N0}}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="15,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#4B5563"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
