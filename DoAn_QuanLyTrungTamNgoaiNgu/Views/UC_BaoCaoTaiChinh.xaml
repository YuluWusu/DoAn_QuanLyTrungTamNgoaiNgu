<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_BaoCaoTaiChinh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.DataContext>
        <vm:VM_BaoCaoTaiChinh/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <vm:IsNegativeConverter x:Key="IsNegativeConverter"/>
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="45" Height="45" Background="#EEF2FF" CornerRadius="10" Margin="0,0,15,0">
                        <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Báo Cáo Tài Chính" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Thống kê doanh thu và chi phí hoạt động" FontSize="13" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Filter Tháng Năm -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tháng:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="#475569"/>
                    <ComboBox Width="60" Height="35" ItemsSource="{Binding DanhSachThang}" SelectedItem="{Binding ThangHienTai}" Margin="0,0,15,0"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                    <TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="#475569"/>
                    <ComboBox Width="80" Height="35" ItemsSource="{Binding DanhSachNam}" SelectedItem="{Binding NamHienTai}"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3 Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tổng Thu -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TỔNG THU" FontSize="13" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TongThu, StringFormat={}{0:N0} đ}" FontSize="28" FontWeight="Bold" Foreground="#10B981" Margin="0,10,0,0"/>
                    <TextBlock Text="Tiền học phí thu từ học viên" FontSize="12" Foreground="#94A3B8" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tổng Chi -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="10,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TỔNG CHI PHÍ" FontSize="13" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TongChi, StringFormat={}{0:N0} đ}" FontSize="28" FontWeight="Bold" Foreground="#EF4444" Margin="0,10,0,0"/>
                    <TextBlock Text="Chi trả lương, điện nước, thiết bị..." FontSize="12" Foreground="#94A3B8" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Lợi Nhuận -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="LỢI NHUẬN RÒNG" FontSize="13" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding LoiNhuan, StringFormat={}{0:N0} đ}" FontSize="28" FontWeight="Bold" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#10B981"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoiNhuan, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Tổng thu trừ Tổng chi phí" FontSize="12" Foreground="#94A3B8" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DataGrids -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bảng Phiếu Thu -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="DANH SÁCH PHIẾU THU" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DsPhieuThu}" AutoGenerateColumns="False" 
                              IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding MAPHIEU}" Width="80"/>
                            <DataGridTextColumn Header="Ngày Thu" Binding="{Binding NGAYTHU, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                            <DataGridTextColumn Header="Số Tiền" Binding="{Binding SOTIEN, StringFormat={}{0:N0}}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#10B981"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Hình Thức" Binding="{Binding HINHTHUCTHU}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Bảng Phiếu Chi -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DANH SÁCH PHIẾU CHI" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        
                        <Button Grid.Column="1" Command="{Binding XoaPhieuChiCommand}" 
                                Content="Xóa" Background="#FEE2E2" Foreground="#EF4444" 
                                Width="60" Height="30" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ThemPhieuChiCommand}" 
                                Content="+ Thêm chi phí" Background="#1E6FB5" Foreground="White" 
                                Width="110" Height="30" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DsPhieuChi}" SelectedItem="{Binding SelectedPhieuChi}" 
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                              Background="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã PC" Binding="{Binding MAPC}" Width="70"/>
                            <DataGridTextColumn Header="Ngày Chi" Binding="{Binding NGAYCHI, StringFormat={}{0:dd/MM/yyyy}}" Width="85"/>
                            <DataGridTextColumn Header="Số Tiền" Binding="{Binding SOTIEN, StringFormat={}{0:N0}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Nội Dung" Binding="{Binding NOIDUNG}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
