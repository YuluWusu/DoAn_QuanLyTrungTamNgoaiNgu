<Window x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.ThemLoaiKhoaHocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Loại Khóa Học" Height="350" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F1F5F9" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="THÊM LOẠI KHÓA HỌC" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10" Foreground="#1E293B"/>

        <StackPanel Grid.Row="1" Margin="20,10">
            <TextBlock Text="Mã Loại Khóa Học:" FontSize="13" Foreground="#64748B"
                       Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="txtMaLoai" Height="38" Padding="10,0"
                     VerticalContentAlignment="Center" FontSize="14"
                     BorderBrush="#E2E8F0" Margin="0,0,0,12"/>
                     
            <TextBlock Text="Tên Loại Khóa Học:" FontSize="13" Foreground="#64748B"
                       Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="txtTenLoai" Height="38" Padding="10,0"
                     VerticalContentAlignment="Center" FontSize="14"
                     BorderBrush="#E2E8F0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="20,10,20,20">
            <Button Content="Hủy" Click="btnHuy_Click"
                    Width="80" Height="36" Background="White"
                    Foreground="#64748B" Margin="0,0,10,0"/>
            <Button Content="Lưu thông tin" Click="btnLuu_Click"
                    Width="130" Height="36" Background="#1E6FB5" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
