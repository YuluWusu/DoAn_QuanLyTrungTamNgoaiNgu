<Window x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.ThemPhieuChiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Phiếu Chi Mới" Height="400" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="THÊM PHIẾU CHI" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#1E293B"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Mã phiếu chi (Tự động/Nhập tay):" FontSize="13" Foreground="#64748B" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="txtMaPC" Height="38" Padding="10,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#E2E8F0" Margin="0,0,0,15"/>

            <TextBlock Text="Ngày chi:" FontSize="13" Foreground="#64748B" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <DatePicker x:Name="dpNgayChi" Height="38" FontSize="14" BorderBrush="#E2E8F0" Margin="0,0,0,15" Padding="5,0"/>

            <TextBlock Text="Số tiền (VNĐ):" FontSize="13" Foreground="#64748B" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="txtSoTien" Height="38" Padding="10,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#E2E8F0" Margin="0,0,0,15"/>

            <TextBlock Text="Nội dung chi:" FontSize="13" Foreground="#64748B" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="txtNoiDung" Height="60" Padding="10,5" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" BorderBrush="#E2E8F0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy bỏ" Click="btnHuy_Click"
                    Width="90" Height="40" Background="White" BorderBrush="#E2E8F0"
                    Foreground="#64748B" Margin="0,0,10,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Lưu phiếu chi" Click="btnLuu_Click"
                    Width="140" Height="40" Background="#1E6FB5" Foreground="White" FontWeight="Bold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
