<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_DanhSachHocPhi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             mc:Ignorable="d" 
            d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F4F6FA">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="QUẢN LÝ KHÓA HỌC" FontSize="24" FontWeight="Bold" Foreground="#1A365D"/>
            <TextBlock Text="Xem danh sách, tìm kiếm và quản lý các khóa học của trung tâm" FontSize="14" Foreground="#718096" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 2. Bộ lọc -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Lọc Loại Khóa Học -->
                    <StackPanel Width="200" Margin="0,0,15,0">
                        <TextBlock Text="Loại khóa học" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,8"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <ComboBox Height="40" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"
                                      ItemsSource="{Binding ListLoaiKhoaHoc}" SelectedItem="{Binding FilterLoaiKH, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="TENLOAI"/>
                        </Border>
                    </StackPanel>

                    <!-- Lọc Số Buổi -->
                    <StackPanel Width="120" Margin="0,0,15,0">
                        <TextBlock Text="Số buổi (tối đa)" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,8"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox Height="40" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" Text="{Binding FilterSoBuoi, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </StackPanel>

                    <!-- Lọc Học Phí -->
                    <StackPanel Width="150" Margin="0,0,15,0">
                        <TextBlock Text="Học phí (tối đa)" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,8"/>
                        <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox Height="40" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" Text="{Binding FilterHocPhi, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </StackPanel>

                    <Button Content="Xóa bộ lọc" Width="100" Height="40" Margin="0,25,0,0" 
                            Background="#3182CE" Foreground="White" FontWeight="Bold" BorderThickness="0" Command="{Binding ClearFilterCommand}" IsEnabled="{Binding IsOtherButtonsEnabled}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding AddCommand}" IsEnabled="{Binding IsOtherButtonsEnabled}" Content="+ THÊM KHÓA HỌC" Width="160" Height="40" Margin="0,25,0,0" 
                        Background="#1E6FB5" Foreground="White" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#1E6FB5"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Border>
 
         <!-- 3. DataGrid Khóa Học (Đã chỉnh sửa giống file UC_HocVien) -->
         <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="10" ClipToBounds="True">
             <Border.Effect>
                 <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
             </Border.Effect>
             <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="{Binding IsReadOnly}"
                       HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="55"
                       BorderThickness="0" Background="Transparent" SelectionMode="Single" 
                       ItemsSource="{Binding ListKhoaHoc}" SelectedItem="{Binding SelectedKhoaHoc}">
 
                 <DataGrid.ColumnHeaderStyle>
                     <Style TargetType="DataGridColumnHeader">
                         <Setter Property="Background" Value="#F9FAFB"/>
                         <Setter Property="Foreground" Value="#6B7280"/>
                         <Setter Property="FontWeight" Value="SemiBold"/>
                         <Setter Property="Padding" Value="15,12"/>
                         <Setter Property="BorderThickness" Value="0,0,0,1"/>
                         <Setter Property="BorderBrush" Value="#F3F4F6"/>
                     </Style>
                 </DataGrid.ColumnHeaderStyle>
 
                 <DataGrid.Columns>
                     <DataGridTextColumn Header="MÃ KH" Binding="{Binding MAKH}" IsReadOnly="True" Width="100">
                         <DataGridTextColumn.ElementStyle>
                             <Style TargetType="TextBlock">
                                 <Setter Property="Margin" Value="15,0"/>
                                 <Setter Property="VerticalAlignment" Value="Center"/>
                                 <Setter Property="Foreground" Value="#6B7280"/>
                             </Style>
                         </DataGridTextColumn.ElementStyle>
                     </DataGridTextColumn>
 
                     <DataGridTextColumn Header="TÊN KHÓA HỌC" Binding="{Binding TENKH, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                         <DataGridTextColumn.ElementStyle>
                             <Style TargetType="TextBlock">
                                 <Setter Property="Margin" Value="15,0"/>
                                 <Setter Property="VerticalAlignment" Value="Center"/>
                                 <Setter Property="FontWeight" Value="Medium"/>
                                 <Setter Property="Foreground" Value="#374151"/>
                             </Style>
                         </DataGridTextColumn.ElementStyle>
                     </DataGridTextColumn>
 
                     <DataGridTextColumn Header="LOẠI KHÓA HỌC" Binding="{Binding LOAI_KHOAHOC.TENLOAI}" IsReadOnly="True" Width="1.5*">
                         <DataGridTextColumn.ElementStyle>
                             <Style TargetType="TextBlock">
                                 <Setter Property="Margin" Value="15,0"/>
                                 <Setter Property="VerticalAlignment" Value="Center"/>
                                 <Setter Property="Foreground" Value="#4B5563"/>
                             </Style>
                         </DataGridTextColumn.ElementStyle>
                     </DataGridTextColumn>
 
                     <DataGridTextColumn Header="SỐ BUỔI" Binding="{Binding SOBUOI, UpdateSourceTrigger=PropertyChanged}" Width="100">
                         <DataGridTextColumn.ElementStyle>
                             <Style TargetType="TextBlock">
                                 <Setter Property="Margin" Value="15,0"/>
                                 <Setter Property="VerticalAlignment" Value="Center"/>
                                 <Setter Property="Foreground" Value="#4B5563"/>
                             </Style>
                         </DataGridTextColumn.ElementStyle>
                     </DataGridTextColumn>
 
                     <DataGridTemplateColumn Header="HỌC PHÍ GỐC" Width="1.5*">
                         <DataGridTemplateColumn.CellTemplate>
                             <DataTemplate>
                                 <TextBlock Text="{Binding HOCPHI_GD, StringFormat={}{0:N0} VNĐ}" VerticalAlignment="Center" Margin="15,0" Foreground="#4B5563"/>
                             </DataTemplate>
                         </DataGridTemplateColumn.CellTemplate>
                         <DataGridTemplateColumn.CellEditingTemplate>
                             <DataTemplate>
                                 <TextBox Text="{Binding HOCPHI_GD, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5,2"/>
                             </DataTemplate>
                         </DataGridTemplateColumn.CellEditingTemplate>
                     </DataGridTemplateColumn>

                     <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                          <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                      <Button Content="✏️" ToolTip="Sửa" 
                                      Background="Transparent" BorderThickness="0" Margin="0,0,15,0" 
                                      FontSize="16" Cursor="Hand"
                                      Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>

                                      <Button Content="🗑️" ToolTip="Xóa" 
                                      Background="Transparent" BorderThickness="0" 
                                      FontSize="16" Cursor="Hand"
                                      Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                                  </StackPanel>
                              </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                 </DataGrid.Columns>
             </DataGrid>
         </Border>
    </Grid>
</UserControl>
