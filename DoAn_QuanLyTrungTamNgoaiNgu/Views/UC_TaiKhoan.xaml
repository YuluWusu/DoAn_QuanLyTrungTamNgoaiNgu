<UserControl x:Class="DoAn_QuanLyTrungTamNgoaiNgu.Views.UC_TaiKhoan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_QuanLyTrungTamNgoaiNgu.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="980"
             Background="#F4F6FA">

    <UserControl.Resources>
        <!-- Styles -->
        <Style x:Key="ContentCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E6FB5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#155B96"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Toolbar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="QUẢN LÝ TÀI KHOẢN" FontSize="24" FontWeight="Bold" Foreground="#1A1A2E"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Background="White" CornerRadius="20" BorderBrush="#D1D5DB" BorderThickness="1.5" Padding="15,2" Width="350" x:Name="SearchBorder">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                                  Fill="#9CA3AF" Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBlock Text="Tìm kiếm theo tên hoặc tài khoản..." Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="txtSearch" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" VerticalAlignment="Center" 
                                         FontSize="13" Padding="0,8"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="+ Thêm tài khoản" Style="{StaticResource PrimaryButton}" Command="{Binding ThemCommand}" Padding="20,10" Margin="0,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid Area -->
            <Border Grid.Column="0" Style="{StaticResource ContentCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding DanhSachTaiKhoan}" SelectedItem="{Binding SelectedTaiKhoan}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                          Background="Transparent" BorderThickness="0" RowHeight="50" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,0,0,10"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="Foreground" Value="#1A1A2E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0,10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#1A1A2E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Tên Đăng Nhập" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TENDANGNHAP}" FontWeight="SemiBold" Foreground="#1A1A2E"/>
                                        <TextBlock Text="{Binding MATK}" FontSize="11" Foreground="#6B7280"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="Họ Tên Người Dùng" Binding="{Binding HoTenNguoiDung}" Width="1.5*"/>
                        
                        <DataGridTemplateColumn Header="Trạng Thái" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrangThaiHoatDong}" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Hoạt động"/>
                                                    <Setter Property="Foreground" Value="#166534"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThaiHoatDong}" Value="False">
                                                            <Setter Property="Text" Value="Khóa"/>
                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Chỉnh sửa" Style="{StaticResource SecondaryButton}" Command="{Binding SuaCommand}" Width="120"/>
                </StackPanel>
                </Grid>
            </Border>

            <!-- Form Detail -->
            <Border Grid.Column="2" Style="{StaticResource ContentCard}" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Chi Tiết Tài Khoản" FontSize="20" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,24"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0" Padding="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Họ và tên *" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,6" Margin="0,0,0,12">
                                <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0"/>
                            </Border>

                            <TextBlock Text="Tên đăng nhập *" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,6" Margin="0,0,0,12">
                                <TextBox Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0"/>
                            </Border>

                            <TextBlock Text="Mật khẩu" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,6" Margin="0,0,0,12">
                                <TextBox Text="{Binding MatKhau, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0"/>
                            </Border>
                            <TextBlock Text="(Để trống nếu không muốn đổi mật khẩu khi sửa)" FontSize="11" Foreground="#9CA3AF" Margin="0,-8,0,12" FontStyle="Italic"/>

                            <TextBlock Text="Loại tài khoản *" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="5" Margin="0,0,0,16">
                                <ComboBox ItemsSource="{Binding LoaiTaiKhoanList}" SelectedItem="{Binding SelectedLoaiTaiKhoan}" Background="Transparent" BorderThickness="0" Padding="5"/>
                            </Border>

                            <!-- Chức vụ: chỉ hiện khi là Nhân viên -->
                            <StackPanel Visibility="{Binding ChucVuVisibility}">
                                <TextBlock Text="Chức vụ *" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="5" Margin="0,0,0,12">
                                    <ComboBox ItemsSource="{Binding DanhSachChucVuDisplay}" SelectedItem="{Binding SelectedChucVuDisplay}" Background="Transparent" BorderThickness="0" Padding="5"/>
                                </Border>
                            </StackPanel>

                            <!-- Thông tin Nhân viên / Admin -->
                            <StackPanel Visibility="{Binding NhanVienFieldsVisibility}">
                                <TextBlock Text="Số điện thoại" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,6" Margin="0,0,0,12">
                                    <TextBox Text="{Binding SDT, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0"/>
                                </Border>
                                <TextBlock Text="Email" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,6" Margin="0,0,0,12">
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0"/>
                                </Border>
                            </StackPanel>

                            <!-- Thông tin Giáo viên -->
                            <StackPanel Visibility="{Binding GiaoVienFieldsVisibility}">
                                <TextBlock Text="Số điện thoại" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,6" Margin="0,0,0,12">
                                    <TextBox Text="{Binding SDT, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0"/>
                                </Border>
                                <TextBlock Text="Email" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,6" Margin="0,0,0,12">
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0"/>
                                </Border>
                                <TextBlock Text="Địa chỉ" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,6" Margin="0,0,0,12">
                                    <TextBox Text="{Binding DiaChi, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0"/>
                                </Border>
                                <TextBlock Text="Trình độ" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="5" Margin="0,0,0,12">
                                    <ComboBox ItemsSource="{Binding DanhSachTrinhDoDisplay}" SelectedItem="{Binding SelectedTrinhDoDisplay}" Background="Transparent" BorderThickness="0" Padding="5"/>
                                </Border>
                            </StackPanel>

                            <CheckBox Content="Đang hoạt động" IsChecked="{Binding TrangThai}" Foreground="#1A1A2E" Margin="0,8,0,20"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Hủy bỏ" Style="{StaticResource SecondaryButton}" Command="{Binding HuyCommand}" Padding="0,12"/>
                            <Button Grid.Column="2" Content="Lưu lại" Style="{StaticResource PrimaryButton}" Command="{Binding LuuCommand}" Padding="0,12"/>
                        </Grid>
                        <Button Content="Xóa tài khoản này" Style="{StaticResource DangerButton}" Command="{Binding XoaCommand}" 
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" 
                                Margin="0,12,0,0" Padding="0,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
